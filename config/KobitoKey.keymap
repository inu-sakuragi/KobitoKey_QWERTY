#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp TAB>;
        };

        toggle_0and2 {
            bindings = <&tog 2>;
            key-positions = <5 9>;
        };
    };

        behaviors {
            td_altgui: td_altgui {
                compatible = "zmk,behavior-tap-dance";
                #binding-cells = <0>;
                tapping-term-ms = <200>;
                bindings = <&kp LALT>, <&kp LGUI>;
            };
        };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                        &kp L         &kp U         &kp COMMA    &kp DOT                  &kp F     &kp W        &kp R      &kp Y                &kp P
&kp E                        &kp I         &kp A         &kp O        &kp MINUS                &kp K     &kp T        &kp N      &kp S                &kp H
&kp Z                        &kp X         &kp C         &kp V        &kp LS(INTERNATIONAL_1)  &kp G     &kp D        &kp M      &kp J                &kp B
&mt LEFT_SHIFT INT_MUHENKAN  &kp X  &td_altgui  &lt 4 SPACE  &kp LCTRL                &kp BSPC  &lt 1 ENTER  &kp RSHFT  &kp INTERNATIONAL_5  &mt LALT SLASH
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp RBKT      &kp NON_US_HASH  &kp LESS_THAN  &kp GREATER_THAN  &kp SEMI  &kp EXCLAMATION  &kp HOME    &kp UP            &kp END     &kp C_VOLUME_UP
&kp LS(RBKT)  &kp LS(BSLH)     &kp LS(N8)     &kp LS(N9)        &kp SQT   &kp QUESTION     &kp LEFT    &kp DOWN          &kp RIGHT   &kp C_VOLUME_DOWN
&kp DELETE    &trans           &trans         &trans            &trans    &kp C_PREV       &kp C_STOP  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE
&trans        &trans           &trans         &trans            &trans    &trans           &trans      &trans            &trans      &trans
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &kp KP_NUMBER_7  &kp KP_N8  &kp KP_NUMBER_9  &sys_reset  &trans   &kp F1  &kp F2        &kp F3      &kp F4
&bt BT_SEL 1  &kp KP_N4        &kp KP_N5  &kp KP_N6        &trans      &trans   &kp F5  &kp F6        &kp F7      &kp F8
&bt BT_SEL 2  &kp KP_NUMBER_1  &kp KP_N2  &kp KP_N3        &trans      &trans   &kp F9  &kp F10       &kp F11     &kp F12
&bt BT_SEL 3  &bt BT_SEL 4     &trans     &trans           &trans      &kp DEL  &trans  &kp LEFT_ALT  &bt BT_CLR  &bt BT_CLR_ALL
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &mkp MB5
&trans     &trans  &trans    &trans    &trans  &trans    &trans    &trans    &trans    &trans
&trans     &trans  &trans    &trans    &trans  &trans    &trans    &trans    &trans    &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &trans    &trans    &trans    &to 0     &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&kp PERCENT  &kp N7  &kp N8  &kp N9  &kp N0             &kp LS(INT_YEN)  &kp LS(N7)  &kp LS(LBKT)  &kp LS(N2)  &kp LS(EQUAL)
&kp LS(SQT)  &kp N4  &kp N5  &kp N6  &kp LS(SEMICOLON)  &kp INT_YEN      &kp LBKT    &kp LS(N6)    &kp HASH    &kp EQUAL
&kp SLASH    &kp N1  &kp N2  &kp N3  &kp LS(MINUS)      &bl BL_TOG       &trans      &trans        &trans      &kp DOLLAR
&trans       &trans  &trans  &trans  &trans             &trans           &trans      &trans        &trans      &kp PRINTSCREEN
            >;
        };
    };
};
